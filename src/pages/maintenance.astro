---
const title = "This website is temporarily unavailable.";
const description = "The website is currently under maintenance and will be restored once the deployment/service period is renewed.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f8fafc" />
    <title>{title}</title>
    <style>
      @import url("https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=clash-display@500,600,700&display=swap");

      :root {
        color-scheme: light;
        font-family: "Satoshi", sans-serif;
        color: #182538;
        background: #f9fbfe;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-width: 320px;
        min-height: 100vh;
        overflow-x: hidden;
        background: #f9fbfe;
      }

      main {
        position: relative;
        isolation: isolate;
        display: grid;
        height: 100svh;
        min-height: 100vh;
        place-items: center;
        padding: clamp(18px, 4vh, 40px) 24px;
        overflow: hidden;
      }

      main::before,
      main::after {
        position: absolute;
        z-index: -1;
        width: 42rem;
        height: 42rem;
        border: 1px solid rgba(105, 143, 195, 0.13);
        border-radius: 50%;
        content: "";
      }

      main::before { top: -28rem; left: -19rem; }
      main::after { right: -25rem; bottom: -27rem; }

      .rays {
        position: absolute;
        z-index: -1;
        right: -7rem;
        bottom: 3rem;
        width: 28rem;
        height: 20rem;
        border: 1px solid rgba(105, 143, 195, 0.11);
        border-radius: 50%;
        transform: rotate(-34deg);
        box-shadow: 0 0 0 16px rgba(105, 143, 195, 0.035), 0 0 0 32px rgba(105, 143, 195, 0.03), 0 0 0 48px rgba(105, 143, 195, 0.025);
      }

      .content {
        width: min(100%, 920px);
        text-align: center;
        animation: rise 0.8s cubic-bezier(.22,.7,.3,1) both;
      }

      .illustration {
        display: block;
        width: auto;
        max-width: 100%;
        height: clamp(170px, 27vh, 300px);
        margin: 0 auto clamp(14px, 2.5vh, 24px);
        mix-blend-mode: multiply;
        object-fit: contain;
      }

      h1 {
        max-width: 920px;
        margin: 0 auto;
        font-family: "Clash Display", sans-serif;
        font-size: clamp(2.25rem, 5vw, 4.5rem);
        font-weight: 600;
        line-height: 1.02;
        letter-spacing: 0;
        color: #17253a;
        text-wrap: balance;
      }

      h1 strong {
        display: block;
        font-weight: 700;
        color: #102e5b;
      }

      .rule {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin: clamp(12px, 2.2vh, 22px) auto clamp(12px, 2vh, 20px);
      }

      .rule::before,
      .rule::after {
        width: 34px;
        height: 2px;
        background: #cbd9ec;
        content: "";
      }

      .rule span {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #5b89c8;
        box-shadow: 0 0 0 5px #e7eef8;
      }

      p {
        max-width: 650px;
        margin: 0 auto;
        color: #5c6572;
        font-size: clamp(0.95rem, 1.35vw, 1.18rem);
        line-height: 1.55;
        text-wrap: balance;
      }

      .note {
        display: flex;
        align-items: center;
        gap: 20px;
        width: min(100%, 520px);
        margin: clamp(18px, 2.5vh, 28px) auto 0;
        padding: 14px 22px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.82);
        box-shadow: 0 14px 35px rgba(34, 57, 90, 0.08);
        text-align: left;
      }

      .note-icon {
        display: grid;
        flex: 0 0 58px;
        width: 58px;
        height: 58px;
        place-items: center;
        border-radius: 50%;
        background: #e8f0fb;
        color: #376baa;
      }

      .note-icon svg { width: 27px; height: 27px; }
      .note p { margin: 0; font-size: 1rem; line-height: 1.45; }
      .note strong { display: block; margin-top: 5px; color: #244c80; font-size: 1.08rem; }

      @keyframes rise {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 560px) {
        main { padding: 16px 18px; }
        .illustration { height: clamp(130px, 22vh, 190px); margin-bottom: 14px; }
        h1 { font-size: clamp(2rem, 10vw, 3rem); }
        .note { align-items: flex-start; gap: 14px; padding: 16px; }
        .note-icon { flex-basis: 50px; width: 50px; height: 50px; }
        .note p { font-size: 0.94rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .content { animation: none; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="rays" aria-hidden="true"></div>
      <section class="content" aria-labelledby="maintenance-title">
        <img class="illustration" src="/images/maintenance-reference.jpeg" alt="Browser window with a gear and construction barrier" width="540" height="360" />
        <h1 id="maintenance-title">This website is <strong>temporarily unavailable.</strong></h1>
        <div class="rule" aria-hidden="true"><span></span></div>
        <p>{description}</p>
        <aside class="note">
          <div class="note-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </div>
          <p>Thank you for your patience and understanding.<strong>We’ll be back soon!</strong></p>
        </aside>
      </section>
    </main>
  </body>
</html>
